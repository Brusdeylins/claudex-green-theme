#!/usr/bin/env bash
##
##  claudex-theme -- apply a custom monochrome-green theme to claudeX.
##
##  Rewrites claudeX' ansi-recolor.conf and patches its tmux.conf on every
##  run, so the customization survives "npm update -g @rse/claudex" (which
##  overwrites those files). Meant to be called right before claudex via an
##  alias (see install.sh):
##
##      alias c="claudex-theme && claudex --tmux --ase --recolor"
##
##  Strategy: recolor only the *chromatic* colors to green and leave the
##  neutral greys / whites / "default" untouched -- so dimmed "side info"
##  (status line, secondary text) stays readable as grey/white instead of
##  turning green. Rules are generated per color index, so it works in ANY
##  Claude Code theme (light or dark) and covers colors not yet seen.
##
##  Customize the values below, then re-run ./install.sh. They are
##  256-color indices (0-255). Preview a range with:
##      for i in $(seq 16 51); do printf '\033[48;5;%dm %3d \033[0m' $i $i; done; echo
##

set -uo pipefail

#   ==== color preferences (edit here, then re-run ./install.sh) ====
GREEN_FG=46         # Vordergrund bunt -> kräftiges Hellgrün (Hauptakzent)
GREEN_FG_DIM=22     # gedimmte bunte Vordergründe -> dunkles Grün
BG_ADD=22           # Diff "added" / grünlicher Hintergrund -> Dunkelgrün
BG_MUTED=236        # Diff "removed" / sonstige bunte Hintergründe -> Dunkelgrau
GREEN_BRIGHT=46     # tmux: aktiv / aktuell
GREEN_MED=34        # tmux: normale Akzente
TMUX_MOUSE=on       # tmux mouse: "on" = Rad scrollt immer. Toggle: "C-a m"
                    #   (Maus aus -> native Terminal-Auswahl/Copy; danach wieder an)

#   ==== statusline ====
#   claudeX hardcodes an "ase statusline ..." command and forces it onto Claude
#   Code via --settings. We just rewrite that command to our format -- ASE 0.9.2+
#   renders everything we need natively, so NO wrapper / helper scripts / ccusage.
#   Each quoted group is one line. Placeholders:
#       %p project %P persona %T task %b git-branch %m model %c context-bar
#       %S/%W session/weekly usage%  %D/%Q their reset time (numeric ts, since 0.9.2)
#       %Y current-month total cost (all sessions; cached, see MONTH_COST_TTL)
#       %e effort %t thinking %X session cost %H elapsed %a/%r lines +/- %d cwd
#   Set STATUSLINE="" to leave claudeX' status line untouched.
MONTH_COST_TTL=300   # ase --month-cost-ttl: seconds to cache %Y (background refresh)
STATUSLINE="ase statusline --month-cost-ttl ${MONTH_COST_TTL} -w 0 -m 2 '%p %P %T %b' '%m %c' '%S %D %W %Q %Y' '%d'"

#   ==== locate the installed claudeX module directory ====
basedir=""
for cand in \
    /usr/local/lib/node_modules/@rse/claudex \
    /opt/homebrew/lib/node_modules/@rse/claudex
do
    if [ -f "$cand/tmux.conf" ]; then basedir="$cand"; break; fi
done
if [ -z "$basedir" ]; then
    ngr="$(npm root -g 2>/dev/null || true)"
    if [ -n "$ngr" ] && [ -f "$ngr/@rse/claudex/tmux.conf" ]; then
        basedir="$ngr/@rse/claudex"
    fi
fi
if [ -z "$basedir" ]; then
    echo "claudex-theme: WARN: claudeX module dir not found -- skipping (claudex starts unthemed)" >&2
    exit 0
fi

#   ==== generate the recolor rules ====
#   Chromatic foreground -> green; chromatic background -> green/grey
#   (greenish bg = added, anything else = muted). Neutral greys/whites and
#   "default" get NO rule, so ansi-recolor passes them through unchanged.
gen_rules () {
    local i c r g b bg name

    #   ANSI named chromatic colors (Claude emits SGR colors as names)
    for name in red green yellow blue magenta cyan \
                bright-red bright-green bright-yellow bright-blue bright-magenta bright-cyan
    do
        printf '    %-18s -> %s/*\n'  "${name}/*"  "${GREEN_FG}"
        printf '    %-18s -> %s/*\n'  "${name}-/*" "${GREEN_FG_DIM}"
    done
    #   ANSI named chromatic backgrounds
    printf '    %-18s -> */%s\n' "*/green"   "${BG_ADD}"
    printf '    %-18s -> */%s\n' "*/red"     "${BG_MUTED}"
    printf '    %-18s -> */%s\n' "*/yellow"  "${BG_MUTED}"
    printf '    %-18s -> */%s\n' "*/blue"    "${BG_MUTED}"
    printf '    %-18s -> */%s\n' "*/magenta" "${BG_MUTED}"
    printf '    %-18s -> */%s\n' "*/cyan"    "${BG_MUTED}"

    #   256-color cube (16-231): skip the grey diagonal (r==g==b),
    #   recolor the rest by hue.
    for i in $(seq 16 231); do
        c=$((i - 16)); r=$((c / 36)); g=$(((c / 6) % 6)); b=$((c % 6))
        [ "$r" -eq "$g" ] && [ "$g" -eq "$b" ] && continue   # grey -> keep
        printf '    %-18s -> %s/*\n'  "${i}/*"  "${GREEN_FG}"
        printf '    %-18s -> %s/*\n'  "${i}-/*" "${GREEN_FG_DIM}"
        if [ "$g" -gt "$r" ] && [ "$g" -gt "$b" ]; then bg="${BG_ADD}"; else bg="${BG_MUTED}"; fi
        printf '    %-18s -> */%s\n'  "*/${i}"  "${bg}"
    done
}
RULES="$(gen_rules)"

#   ==== 1) ansi-recolor.conf (full overwrite) ====
{
    echo "##  CUSTOM monochrome-green theme (auto-generated by claudex-theme)."
    echo "##  Do NOT edit here -- edit the claudex-theme script and re-run ./install.sh."
    echo ""
    echo "default:"
    echo ""
    echo "claude:"
    echo "$RULES"
    echo ""
    echo "lazygit:"
    echo "$RULES"
} > "$basedir/ansi-recolor.conf"

#   ==== 2) tmux.conf -- recolor the chrome (idempotent in-place patch) ====
#   red  -> bright green (active / current), blue -> medium green (info).
sed -i '' \
    -e "s/fg=red/fg=colour${GREEN_BRIGHT}/g" \
    -e "s/fg=blue/fg=colour${GREEN_MED}/g" \
    "$basedir/tmux.conf"
#   mouse: enable by default so the wheel always scrolls ("C-a m" still toggles
#   it off for native terminal text selection / clipboard copy).
sed -i '' -E "s/set-option -g mouse (on|off)/set-option -g mouse ${TMUX_MOUSE}/" "$basedir/tmux.conf"

#   ==== 3) statusline -- patch claudeX' hardcoded command (idempotent) ====
#   Everything is native in ASE 0.9.2+, so just rewrite the "command" string.
#   Also remove wrapper / helper artefacts from earlier tool versions.
rm -f "$basedir/claudex-statusline" "$basedir/claudex-usage.js" "$basedir/claudex-month.js"
if [ -n "$STATUSLINE" ]; then
    #   matches the stock "ase statusline ..." OR an already-patched value
    #   (current command, or a legacy wrapper path ending in claudex-statusline)
    for jsf in "$basedir/claudex.js" "$basedir/claude-settings.json"; do
        [ -f "$jsf" ] && sed -i '' -E \
            "s#(\"command\": \")(ase statusline[^\"]*|[^\"]*claudex-statusline)(\")#\1${STATUSLINE}\3#" \
            "$jsf"
    done
fi

exit 0
